# Rename this file to ".env" and fill in your real values.

# Token you get from @BotFather after creating your bot
BOT_TOKEN=123456789:AAExampleTokenGoesHere

# Your own numeric Telegram user ID (get it from @userinfobot).
# This is who is allowed to use /addphoto, /removephoto, /listphotos.
# You can list more than one, comma-separated: ADMIN_IDS=111111,222222
ADMIN_IDS=123456789
